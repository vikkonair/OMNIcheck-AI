{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniware.example/schemas/canonical-check-result-1.0.json",
  "title": "Omni Health-check Canonical Check Result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "check_id",
    "section_id",
    "node",
    "node_role",
    "product",
    "collected_at",
    "evidence",
    "assessment",
    "trace"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "check_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "section_id": {"type": "string", "minLength": 1},
    "node": {"type": "string", "minLength": 1},
    "node_role": {
      "enum": ["Primary", "Standby", "DR", "Witness"]
    },
    "product": {
      "enum": ["OS", "PostgreSQL", "EPAS", "PEM", "EFM"]
    },
    "collected_at": {
      "type": ["string", "null"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": {"const": "table"},
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "assessment": {"type": "null"},
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser_id", "rule_id", "evidence_sha256"],
      "properties": {
        "parser_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": ["string", "null"]},
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
